# Copy to mobile/.env.local for local development.
# Use the same Supabase project as the production web app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Existing VibeTravel web/API deployment. No trailing slash.
EXPO_PUBLIC_API_URL=https://vibe-travel-six.vercel.app
EXPO_PUBLIC_SITE_URL=https://vibe-travel-six.vercel.app

# Optional privacy-safe mobile error and latency monitoring.
EXPO_PUBLIC_SENTRY_DSN=
# Build-time source-map upload credentials. Never prefix these with EXPO_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
