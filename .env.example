# VibeTravel — environment variables
# Copy to .env.local and fill in values. Never commit .env.local.

# ── Required ─────────────────────────────────────────────────────────
# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — powers Scout chat, search, and itinerary generation.
# Read automatically by @ai-sdk/anthropic; the app will not function without it.
ANTHROPIC_API_KEY=

# ── Optional: app ────────────────────────────────────────────────────
# Canonical site URL for social/OG link previews (falls back to the Vercel URL)
NEXT_PUBLIC_SITE_URL=

# ── Optional: real-data enrichment ───────────────────────────────────
# The app works without these — it falls back to AI-generated data.
GOOGLE_PLACES_API_KEY=      # attraction photos, ratings, hours, static maps
OPENWEATHER_API_KEY=        # weather forecasts used in itinerary planning
VIATOR_API_KEY=             # bookable tours
VIATOR_SANDBOX=             # "true" to hit Viator's sandbox, "false"/unset for prod
EXPEDIA_RAPID_API_KEY=      # hotel availability
YELP_API_KEY=               # restaurant data (Google Places covers this too)
YOUTUBE_API_KEY=            # destination vlogs
TAVILY_API_KEY=             # multi-source travel articles (Reads sidebar) — https://app.tavily.com

# ── Optional: beta feedback ──────────────────────────────────────────
SLACK_FEEDBACK_WEBHOOK_URL= # posts in-app beta feedback to a Slack channel

# ── Planned (going-public checklist — not yet wired) ─────────────────
# Rate limiting on public/AI endpoints — Upstash Redis (@upstash/ratelimit)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Error tracking — Sentry
# NEXT_PUBLIC_SENTRY_DSN=
